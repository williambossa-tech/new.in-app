# =====================================================================
# NEW.IN Comunidade — exemplo de configuração (SEM credenciais reais)
# Copie para .env.local em desenvolvimento. Em produção, cadastre no
# Railway (Variables). Nunca coloque chaves no código nem no navegador.
# =====================================================================

# --- Banco e ambiente ---
DATABASE_URL=postgres://postgres@localhost:5432/newin
APP_ENV=demonstracao                 # producao | demonstracao
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=  # openssl rand -base64 32

# --- Primeiro administrador (remova a senha depois do primeiro acesso) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Corujinha: respostas com IA (use UMA das duas) ---
OPENAI_API_KEY=                      # platform.openai.com › API keys (começa com sk-proj-)
ANTHROPIC_API_KEY=                   # console.anthropic.com › API Keys (começa com sk-ant-)
CORUJINHA_MODEL=                     # opcional: força um modelo; vazio = escolha automática

# --- Corujinha: voz (identidade vocal única) ---
TTS_PROVIDER=auto                    # auto | openai | elevenlabs   (auto: ElevenLabs se configurado; senão OpenAI)
TTS_SPEED=1.0                        # 0.7 a 1.3
TTS_VOLUME=0.9                       # volume padrão no app (0 a 1)
TTS_EXPRESSIVIDADE=0.6               # 0 (contida) a 1 (bem expressiva)
TTS_ESTILO=                          # opcional: substitui a descrição da personagem enviada ao provedor

# OpenAI (usa a mesma OPENAI_API_KEY acima)
OPENAI_TTS_MODEL=gpt-4o-mini-tts     # atenção: a OpenAI desliga este modelo em 06/01/2027
OPENAI_TTS_VOICE=coral               # voz fixa da Corujinha (ex.: coral, shimmer, nova, sage, marin)

# ElevenLabs (recomendado para a voz definitiva)
ELEVENLABS_API_KEY=                  # elevenlabs.io › Developers › API Keys
ELEVENLABS_VOICE_ID=                 # ID da voz escolhida/criada para a Corujinha (Voice Library ou Voice Design)
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.4             # menor = mais emoção; maior = mais estável
ELEVENLABS_SIMILARITY=0.8
